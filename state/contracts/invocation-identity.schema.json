{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ai-company:contract:invocation-identity:1.0",
  "title": "Invocation Identity v1",
  "type": "object",
  "required": [
    "schema_version",
    "run_id",
    "invocation_id",
    "role",
    "provider",
    "model",
    "runner_instance_id",
    "issued_by",
    "issued_at"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "run_id": {
      "type": "string",
      "format": "uuid"
    },
    "invocation_id": {
      "type": "string",
      "format": "uuid"
    },
    "role": {
      "type": "string",
      "minLength": 1
    },
    "provider": {
      "type": "string",
      "minLength": 1
    },
    "model": {
      "type": "string",
      "minLength": 1
    },
    "runner_instance_id": {
      "type": "string",
      "format": "uuid"
    },
    "issued_by": {
      "type": "string",
      "minLength": 1
    },
    "issued_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "additionalProperties": false
}
